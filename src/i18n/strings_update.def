VT_STR(UPDATE_WARNING_DETAIL, "Questo aggiornamento sostituira SSSPlayer (homebrew). Continuare?", "This update will replace SSSPlayer (homebrew). Continue?")
VT_STR(UPDATE_INSTALL, "Si, installa", "Yes, install")
VT_STR(UPDATE_LATER, "No", "No")
VT_STR(UPDATE_DOWNLOADING, "Download aggiornamento…", "Downloading update…")
VT_STR(UPDATE_INSTALLING, "Installazione…", "Installing…")
VT_STR(UPDATE_FAILED_TITLE, "Aggiornamento non riuscito", "Update failed")
VT_STR(UPDATE_CANCELLED, "Download annullato", "Download cancelled")
VT_STR(UPDATE_EXTRACT_FAILED, "Estrazione VPK non riuscita", "Could not extract the VPK")
VT_STR(UPDATE_DONE_TITLE, "Aggiornamento installato", "Update installed")
VT_STR(UPDATE_DONE_DETAIL, "Riavvio… riapri SSSPlayer dal LiveArea se serve.", "Restarting… reopen SSSPlayer from LiveArea if needed.")
