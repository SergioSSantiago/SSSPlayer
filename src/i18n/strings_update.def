VT_STR(UPDATE_AVAILABLE_TITLE, "Aggiornamento disponibile", "Update available")
VT_STR(UPDATE_AVAILABLE_DETAIL, "Versione %s (hai %s). Installare ora?", "Version %s (you have %s). Install now?")
